Screen {
    background: #0b0e14;
    color: #e2e8f0;
    layout: vertical;
    overflow: hidden;
}

#root {
    width: 100%;
    height: 100%;
    padding: 0 1;
    layout: vertical;
}

/* ==========================================================================
   Header Bar (Compacto & Minimalista)
   ========================================================================== */
#header-bar {
    width: 100%;
    height: 1;
    layout: horizontal;
    margin-bottom: 0;
    padding: 0;
    background: transparent;
}

#app-brand {
    color: #00f5d4;
    text-style: bold;
    width: auto;
    margin-right: 3;
}

#header-status {
    color: #94a3b8;
    width: auto;
}

/* ==========================================================================
   Main Layout & Panels
   ========================================================================== */
#main-layout {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    margin-top: 0;
}

/* Coluna Esquerda: Settings */
#settings-panel {
    width: 36;
    height: 100%;
    border: round #38bdf8;
    background: #0b0e14;
    padding: 0 1;
    margin-right: 1;
}

.fieldset-box {
    width: 100%;
    border: round #22374d;
    background: #0d121c;
    padding: 0 1;
    margin-bottom: 1;
}

#box-input {
    height: 6;
    padding-bottom: 0;
}

.input-row {
    width: 100%;
    height: 3;
    layout: horizontal;
}

.file-browse-btn {
    width: 9;
    min-width: 9;
    max-width: 9;
    height: 3;
    background: #111827;
    color: #38bdf8;
    border: round #38bdf8;
    text-style: bold;
    content-align: center middle;
    margin-right: 1;
    padding: 0;
}

.file-browse-btn:hover {
    background: #1e293b;
    color: #00f5d4;
}

#input-path {
    width: 1fr;
    height: 3;
    background: #111827;
    border: round #22374d;
    color: #f8fafc;
    padding: 0 1;
}

#input-path:focus {
    border: round #00e5ff;
}

.browse-hint-link {
    width: 100%;
    height: 1;
    background: transparent;
    border: none;
    color: #64748b;
    text-align: right;
    padding: 0;
    margin-top: 0;
}

.browse-hint-link:hover {
    color: #38bdf8;
    text-style: underline;
}

#box-profile {
    height: 6;
}

#profile-list {
    height: 4;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#profile-list > .option-list--option {
    padding: 0 1;
    color: #cbd5e1;
}

#profile-list > .option-list--option.-highlighted {
    background: #16283b;
    color: #00f5d4;
    text-style: bold;
}

#box-level {
    height: 6;
}

#level-set {
    height: 4;
    background: transparent;
    border: none;
    padding: 0;
}

RadioButton {
    color: #94a3b8;
    padding: 0;
    margin: 0;
}

RadioButton:hover {
    color: #e2e8f0;
}

RadioButton.-on {
    color: #00f5d4;
    text-style: bold;
}

.pill-audio {
    width: 100%;
    height: 3;
    background: #162030;
    border: round #22374d;
    color: #f8fafc;
    text-style: bold;
    margin-bottom: 1;
}

.pill-audio:hover {
    background: #1e293b;
    border: round #38bdf8;
}

.pill-audio.inactive {
    background: #0f172a;
    color: #64748b;
    border: round #1e293b;
}

/* Action Buttons Container (Iniciar / Pausar / Parar) */
#action-btn-container {
    width: 100%;
    height: 3;
    layout: horizontal;
    margin-bottom: 0;
}

.pill-start {
    width: 100%;
    height: 3;
    background: #00f5d4;
    color: #02150d;
    text-style: bold;
    border: none;
}

.pill-start:hover {
    background: #10b981;
}

.pill-pause {
    width: 1fr;
    min-width: 8;
    height: 3;
    background: #f59e0b;
    color: #000000;
    text-style: bold;
    border: none;
    margin-right: 1;
}

.pill-pause:hover {
    background: #d97706;
}

.pill-resume {
    width: 1fr;
    min-width: 8;
    height: 3;
    background: #10b981;
    color: #000000;
    text-style: bold;
    border: none;
    margin-right: 1;
}

.pill-resume:hover {
    background: #059669;
}

.pill-stop {
    width: 1fr;
    min-width: 8;
    height: 3;
    background: #ef4444;
    color: #ffffff;
    text-style: bold;
    border: none;
}

.pill-stop:hover {
    background: #dc2626;
}

/* Coluna Direita: Status & Log + Performance Monitor */
#right-column {
    width: 1fr;
    height: 100%;
    layout: vertical;
}

#status-log-panel {
    width: 100%;
    height: 1fr;
    border: round #38bdf8;
    background: #0b0e14;
    padding: 0 1;
    margin-bottom: 1;
}

.status-progress-text {
    width: 100%;
    height: 1;
    color: #00f5d4;
    text-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

#pipeline-chevrons {
    width: 100%;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
}

#output-label {
    color: #94a3b8;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
}

#log-container {
    width: 100%;
    height: 1fr;
    border: round #1e293b;
    background: #080c14;
    padding: 0 1;
    margin-top: 0;
}

#log {
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    padding: 0;
}

/* Performance Monitor */
#performance-panel {
    width: 100%;
    height: 10;
    border: round #38bdf8;
    background: #0b0e14;
    padding: 0 1;
}

#perf-split {
    width: 100%;
    height: 100%;
    layout: horizontal;
}

.perf-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

.perf-col-title {
    color: #38bdf8;
    text-style: bold;
    height: 1;
    margin-bottom: 0;
}

#cpu-sparkline {
    width: 100%;
    height: 1fr;
    color: #38bdf8;
    background: #080c14;
    border: round #1e293b;
}

#gpu-sparkline {
    width: 100%;
    height: 1fr;
    color: #0284c7;
    background: #080c14;
    border: round #1e293b;
}

/* Stats Strip & Footer */
#stats-strip {
    width: 100%;
    height: 1;
    margin-top: 0;
    color: #94a3b8;
    padding: 0 1;
}

#memory-metric {
    width: 100%;
    color: #94a3b8;
}

#custom-footer {
    width: 100%;
    height: 1;
    background: #0d1117;
    padding: 0 1;
}

#footer-keys {
    width: 100%;
    color: #cbd5e1;
}

.hidden {
    display: none;
}

/* ==========================================================================
   File Browser Modal Dialog
   ========================================================================== */
FileBrowserModal {
    align: center middle;
    background: rgba(11, 14, 20, 0.85);
}

#modal-dialog {
    width: 80;
    height: 26;
    border: round #38bdf8;
    background: #0d121c;
    padding: 1 2;
}

#modal-title {
    color: #00f5d4;
    text-style: bold;
    text-align: center;
    height: 1;
    margin-bottom: 1;
}

#modal-quick-nav {
    width: 100%;
    height: 3;
    layout: horizontal;
    margin-bottom: 0;
}

.nav-btn {
    height: 3;
    background: #1e293b;
    color: #38bdf8;
    border: none;
    margin-right: 1;
    padding: 0 1;
}

.nav-btn:hover {
    background: #38bdf8;
    color: #02150d;
}

#modal-path-display {
    color: #94a3b8;
    height: 1;
    margin-bottom: 1;
}

#modal-dir-tree {
    width: 100%;
    height: 1fr;
    background: #080c14;
    border: round #1e293b;
    padding: 0 1;
    margin-bottom: 1;
}

#modal-input-row {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#modal-selected-input {
    width: 100%;
    height: 3;
    background: #111827;
    border: round #22374d;
    color: #f8fafc;
}

#modal-btn-row {
    width: 100%;
    height: 3;
    layout: horizontal;
    align: right middle;
}

.modal-btn-confirm {
    width: 16;
    height: 3;
    background: #00f5d4;
    color: #02150d;
    text-style: bold;
    border: none;
    margin-right: 2;
}

.modal-btn-confirm:hover {
    background: #10b981;
}

.modal-btn-cancel {
    width: 14;
    height: 3;
    background: #ef4444;
    color: #ffffff;
    text-style: bold;
    border: none;
}

.modal-btn-cancel:hover {
    background: #dc2626;
}
