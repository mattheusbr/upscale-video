Screen {
    background: #0b0e14;
    color: #e2e8f0;
    layout: vertical;
    overflow: hidden;
}

#root {
    width: 100%;
    height: 100%;
    padding: 0 1;
    layout: vertical;
}

/* ==========================================================================
   Header Bar
   ========================================================================== */
#header-bar {
    width: 100%;
    height: 4;
    padding: 0 1;
    margin-bottom: 0;
}

#header-title-row {
    width: 100%;
    height: 1;
    margin-bottom: 0;
}

#app-brand {
    color: #00f5d4;
    text-style: bold;
    width: auto;
}

#app-version-status {
    color: #64748b;
    margin-left: 2;
    width: auto;
}

#header-cmd-row {
    width: 100%;
    height: 3;
    align: center middle;
    margin-top: 0;
}

#cmd-input {
    width: 1fr;
    height: 3;
    background: #111827;
    border: round #38bdf8;
    color: #f8fafc;
    padding: 0 1;
}

#cmd-input:focus {
    border: round #00e5ff;
}

#gradient-bar {
    width: auto;
    height: 3;
    content-align: center middle;
    padding: 0 1;
}

.send-btn {
    width: 10;
    height: 3;
    background: #f72585;
    color: #ffffff;
    text-style: bold;
    border: none;
    margin-left: 1;
}

.send-btn:hover {
    background: #ff007f;
}

/* ==========================================================================
   Main Layout
   ========================================================================== */
#main-layout {
    width: 100%;
    height: 1fr;
    layout: horizontal;
    margin-top: 0;
}

/* Settings Column */
#settings-panel {
    width: 36%;
    height: 100%;
    border: round #38bdf8;
    background: #10141d;
    padding: 0 1;
    margin-right: 1;
    overflow-y: auto;
}

.fieldset-box {
    border: round #38bdf8;
    background: #131b26;
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
}

.input-row {
    width: 100%;
    height: 3;
    align: center middle;
    background: #1c2635;
}

#input-path {
    width: 1fr;
    height: 3;
    border: none;
    background: transparent;
    color: #f8fafc;
    padding: 0 1;
}

.icon-btn {
    width: 4;
    height: 3;
    border: none;
    background: transparent;
    color: #38bdf8;
    margin-right: 0;
}

.icon-btn:hover {
    background: #253346;
}

#profile-list {
    height: 4;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
}

#profile-list > .option-list--option {
    padding: 0 1;
    color: #cbd5e1;
}

#profile-list > .option-list--option.-highlighted {
    background: #1e293b;
    color: #00f5d4;
    text-style: bold;
}

#level-set {
    height: auto;
    background: transparent;
    border: none;
    padding: 0;
}

RadioButton {
    color: #94a3b8;
    padding: 0;
    margin: 0;
}

RadioButton:hover {
    color: #e2e8f0;
}

RadioButton.-on {
    color: #00f5d4;
    text-style: bold;
    background: #1a2738;
    width: 100%;
}

.pill-audio {
    width: 100%;
    height: 3;
    background: #115e59;
    color: #99f6e4;
    text-style: bold;
    border: none;
    margin-bottom: 1;
}

.pill-audio.inactive {
    background: #1f2937;
    color: #94a3b8;
}

.pill-start {
    width: 100%;
    height: 3;
    background: #00e5ff;
    color: #090d16;
    text-style: bold;
    border: none;
}

.pill-start:hover {
    background: #38bdf8;
}

/* Right Column */
#right-column {
    width: 64%;
    height: 100%;
    layout: vertical;
}

#status-log-panel {
    height: 3fr;
    border: round #38bdf8;
    background: #10141d;
    padding: 0 1;
}

#performance-panel {
    height: 1fr;
    border: round #38bdf8;
    background: #10141d;
    padding: 0 1;
    margin-top: 1;
}

.panel-header-title {
    color: #38bdf8;
    text-style: bold;
    display: none;
}

#status-display {
    color: #e2e8f0;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
}

#progress-bar {
    width: 100%;
    height: 1;
    margin-bottom: 0;
}

ProgressBar > .bar--bar {
    background: #d946ef;
}

ProgressBar > .bar--complete {
    background: #00f5d4;
}

#pipeline-chevrons {
    width: 100%;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
}

#output-label {
    color: #94a3b8;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
}

#log-container {
    width: 100%;
    height: 1fr;
    border: round #1e293b;
    background: #0d121c;
    padding: 0 1;
}

#log {
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    padding: 0;
}

/* Performance Monitor Split */
#perf-split {
    width: 100%;
    height: 100%;
    layout: horizontal;
}

.perf-col {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}

.perf-col-title {
    color: #38bdf8;
    text-style: bold;
    height: 1;
    margin-bottom: 0;
}

#cpu-sparkline {
    width: 100%;
    height: 1fr;
    color: #38bdf8;
    background: #0d121c;
    border: round #1e293b;
}

#gpu-sparkline {
    width: 100%;
    height: 1fr;
    color: #10b981;
    background: #0d121c;
    border: round #1e293b;
}

/* ==========================================================================
   Stats Strip & Footer
   ========================================================================== */
#stats-strip {
    width: 100%;
    height: 2;
    padding: 0 1;
    margin-top: 0;
    border-top: solid #1e293b;
    layout: horizontal;
    align: center middle;
}

#memory-metric {
    width: auto;
    color: #94a3b8;
    margin-right: 2;
}

#state-label {
    width: auto;
    color: #64748b;
    margin-right: 1;
}

.state-badge {
    width: auto;
    padding: 0 1;
    background: #1e293b;
    color: #475569;
    text-style: bold;
    margin-right: 1;
}

#badge-ready.active {
    background: #10b981;
    color: #022c22;
}

#badge-processing.active {
    background: #f59e0b;
    color: #451a03;
}

#badge-complete.active {
    background: #06b6d4;
    color: #083344;
}

#custom-footer {
    width: 100%;
    height: 1;
    background: #080c14;
    color: #94a3b8;
    padding: 0 1;
    margin-top: 0;
}

#footer-keys {
    width: 100%;
    color: #cbd5e1;
}
